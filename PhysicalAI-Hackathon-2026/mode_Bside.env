# Depth test: mode B with the battery, and the table + wrist depth saved to debug/ (*_depth.npz) at every look and peek. The request must have been submitted with CAPTURE_DEPTH=1 so the cell sends depth.
TRIAL_MODES=B
TARGET_OBJECT=battery
ADAPTIVE_OFFSET=1
GRASP_FRAME=gripper
CAPTURE_DEPTH=1
WRIST_SHIFT_B=0,0
EXPLORE_MM=0.8
EXPLORE_BAD=0.3
EXPLORE_SWEEP=-8,-7,-6,-9,-10,-5
SWEEP_FROM=9
SIDE=1
VERIFY_GATE=0
