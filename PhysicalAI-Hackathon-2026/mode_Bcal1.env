# Self-calibration ON: calibration_model.json is applied to the table estimate; the same logging gives the with/without comparison.
# Gate on, no deliberate misses, no offset jitter: clean runs. Target comes from target_object.txt.
TRIAL_MODES=B
TARGET_OBJECT=battery
ADAPTIVE_OFFSET=1
GRASP_FRAME=gripper
CAPTURE_DEPTH=1
WRIST_SHIFT_B=0,0
EXPLORE_SWEEP=-8,-7,-6,-9,-10,-5
SWEEP_FROM=9
SIDE=1
EXPLORE_BAD=0
VERIFY_GATE=1
EXPLORE_MM=0
CALIB_APPLY=1
